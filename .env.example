# PostgreSQL connection (Supabase local DB runs on port 54322)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=public"

# Supabase local API
SUPABASE_URL="http://127.0.0.1:54321"

# Use the "Secret" key from `npx supabase start` output (service_role — bypasses RLS)
SUPABASE_KEY="sb_secret_..."

# OpenAI
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o"

# Firebase (pick ONE — JSON env var takes priority over file path)
FIREBASE_SERVICE_ACCOUNT_JSON=     # Raw JSON string (for Railway/cloud deploys)
FIREBASE_SERVICE_ACCOUNT_PATH=     # Path to JSON file (for local dev)
